# Local MongoDB, or replace with your MongoDB Atlas connection string.
ATLASDB_URL=mongodb://127.0.0.1:27017/wanderlust_demo
SECRET=replace-with-a-long-random-session-secret
PORT=8080

# Mapbox public access token (maps and listing geocoding).
MAP_TOKEN=

# Cloudinary credentials (listing image uploads).
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
